# Copy this file to .env and fill in your API keys.
# Do NOT commit .env to version control.

ANTHROPIC_API_KEY=YOUR_KEY_HERE

# Voyage AI key for semantic embeddings (default provider).
# Get one at https://www.voyageai.com/ — required for semantic/hybrid
# search and Q&A retrieval. Keyword search works without it.
VOYAGE_API_KEY=YOUR_KEY_HERE

# Optional: override the embedding backend (defaults: voyage / voyage-4).
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-4

# Optional: set to "true" to enable Flask debug mode (not for production)
FLASK_DEBUG=false
