# Copy this file to .env and fill in your API keys.
# Do NOT commit .env to version control.

ANTHROPIC_API_KEY=YOUR_KEY_HERE

# Voyage AI key for semantic embeddings (default provider).
# Get one at https://www.voyageai.com/ — required for semantic/hybrid
# search and Q&A retrieval. Keyword search works without it.
VOYAGE_API_KEY=YOUR_KEY_HERE

# Optional: override the embedding backend (defaults: voyage / voyage-4).
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-4

# Optional (EXPERIMENTAL): backend used for the final Q&A answer generation.
# "claude" (default) uses the Anthropic API; "ollama" uses a local Ollama
# server and needs no ANTHROPIC_API_KEY. Retrieval, evidence, context and
# citation parsing is identical either way — only the generator changes.
# QA_PROVIDER=claude
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_QA_MODEL=qwen3:14b
# OLLAMA_NUM_CTX=32768
# OLLAMA_QA_THINK=false
# OLLAMA_QA_TIMEOUT=300

# Optional: set to "true" to enable Flask debug mode (not for production)
FLASK_DEBUG=false
